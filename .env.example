# ===========================================
# 水处理平台 v2.0 环境变量配置
# ===========================================
# 复制此文件为 .env.local 并填写实际值
# 注意：.env.local 不会提交到版本控制
# ===========================================

# ========== AI 服务配置 ==========

# 方案1：硅基流动 API（推荐，免费额度）
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_MODEL=Pro/zai-org/GLM-5.1
SILICONFLOW_API_BASE_URL=https://api.siliconflow.cn/v1

# 方案2：Coze API（备选，需要Coze平台配置）
# COZE_API_KEY=your_coze_api_key
# COZE_BOT_ID=your_bot_id

# ========== 对象存储配置（腾讯云COS）==========
# PDF文件需要上传到对象存储，图片可以直接base64
# 腾讯云COS支持S3兼容API，使用以下配置：

# COS Endpoint（对象存储地址）
# 格式：https://cos.{region}.myqcloud.com
COS_ENDPOINT_URL=https://cos.ap-guangzhou.myqcloud.com

# COS 区域
COS_REGION=ap-guangzhou

# COS 存储桶名称
COS_BUCKET_NAME=your-bucket-name

# COS 访问密钥（从腾讯云控制台获取）
COS_SECRET_ID=your_secret_id
COS_SECRET_KEY=your_secret_key

# ========== 兼容性配置（旧版）==========
# 以下变量名称仍然支持，但推荐使用 COS_* 前缀
# COZE_BUCKET_ENDPOINT_URL=your_endpoint_url
# COZE_ACCESS_KEY=your_access_key
# COZE_SECRET_KEY=your_secret_key
# COZE_BUCKET_NAME=your_bucket_name

# ========== 服务器配置 ==========
DEPLOY_RUN_PORT=5000
